<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="560.0"
            prefWidth="850.0"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="hr.algebra.theaterapp_gui.controller.DirectorController">

    <top>
        <VBox spacing="10.0">
            <padding>
                <Insets top="15.0"
                        right="20.0"
                        bottom="10.0"
                        left="20.0"/>
            </padding>

            <children>
                <Label text="Directors"
                       style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

                <HBox spacing="8.0">
                    <children>
                        <TextField fx:id="searchField"
                                   promptText="Search by first name, last name or director ID"/>

                        <Button text="Search"
                                onAction="#search"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </top>

    <center>
        <TableView fx:id="directorTableView">
            <BorderPane.margin>
                <Insets top="5.0"
                        right="20.0"
                        bottom="5.0"
                        left="20.0"/>
            </BorderPane.margin>

            <columns>
                <TableColumn fx:id="firstNameColumn"
                             prefWidth="150.0"
                             text="First name"/>

                <TableColumn fx:id="lastNameColumn"
                             prefWidth="150.0"
                             text="Last name"/>

                <TableColumn fx:id="directionStyleColumn"
                             prefWidth="180.0"
                             text="Direction style"/>

                <TableColumn fx:id="directorIdColumn"
                             prefWidth="180.0"
                             text="Director ID"/>
            </columns>
        </TableView>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT"
              spacing="10.0">
            <padding>
                <Insets top="10.0"
                        right="20.0"
                        bottom="15.0"
                        left="20.0"/>
            </padding>

            <children>
                <Button fx:id="addButton"
                        text="Add"
                        onAction="#addDirector"/>

                <Button fx:id="editButton"
                        text="Edit"
                        onAction="#editDirector"/>

                <Button fx:id="deleteButton"
                        text="Delete"
                        onAction="#deleteDirector"/>
            </children>
        </HBox>
    </bottom>

</BorderPane>