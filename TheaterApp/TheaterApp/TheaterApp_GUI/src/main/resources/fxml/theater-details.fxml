<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="620.0"
            prefWidth="900.0"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="hr.algebra.theaterapp_gui.controller.TheaterDetailsController">

    <top>
        <VBox spacing="12.0">
            <padding>
                <Insets top="15.0"
                        right="20.0"
                        bottom="10.0"
                        left="20.0"/>
            </padding>

            <children>
                <Label fx:id="theaterNameLabel"
                       text="Theater details"
                       style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

                <HBox spacing="20.0"
                      VBox.vgrow="ALWAYS">

                    <children>
                        <ImageView fx:id="theaterImageView"
                                   fitWidth="320.0"
                                   fitHeight="220.0"
                                   preserveRatio="true"
                                   smooth="true"/>

                        <VBox spacing="8.0"
                              HBox.hgrow="ALWAYS">

                            <children>
                                <Label text="Repertoire"
                                       style="-fx-font-size: 17px; -fx-font-weight: bold;"/>

                                <TableView fx:id="playTableView"
                                           prefHeight="220.0"
                                           VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="playNameColumn"
                                                     text="Play"
                                                     prefWidth="150.0"/>

                                        <TableColumn fx:id="playTypeColumn"
                                                     text="Type"
                                                     prefWidth="85.0"/>

                                        <TableColumn fx:id="premierDateColumn"
                                                     text="Premier"
                                                     prefWidth="105.0"/>

                                        <TableColumn fx:id="directorColumn"
                                                     text="Director"
                                                     prefWidth="150.0"/>

                                        <TableColumn fx:id="performanceCounterColumn"
                                                     text="Performances"
                                                     prefWidth="100.0"/>
                                    </columns>
                                </TableView>
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <GridPane hgap="12.0"
                          vgap="8.0">
                    <columnConstraints>
                        <ColumnConstraints minWidth="120.0"
                                           prefWidth="140.0"/>

                        <ColumnConstraints minWidth="300.0"
                                           prefWidth="650.0"/>
                    </columnConstraints>

                    <children>
                        <Label text="City:"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="0"/>

                        <Label fx:id="cityLabel"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="0"/>

                        <Label text="Address:"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="1"/>

                        <Label fx:id="addressLabel"
                               wrapText="true"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="1"/>

                        <Label text="Founded:"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="2"/>

                        <Label fx:id="foundedYearLabel"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="2"/>

                        <Label text="Capacity:"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="3"/>

                        <Label fx:id="capacityLabel"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="3"/>
                    </children>
                </GridPane>

                <Label text="History:"
                       style="-fx-font-weight: bold;"/>

                <TextArea fx:id="historyTextArea"
                          editable="false"
                          focusTraversable="false"
                          prefHeight="100.0"
                          wrapText="true"/>
            </children>
        </VBox>
    </top>

    <bottom>
        <HBox alignment="CENTER_RIGHT">
            <padding>
                <Insets top="5.0"
                        right="20.0"
                        bottom="15.0"
                        left="20.0"/>
            </padding>

            <children>
                <Button text="Export XML"
                        onAction="#exportXml"/>

                <Button text="Close"
                        onAction="#close"/>
            </children>
        </HBox>
    </bottom>

</BorderPane>