<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="520.0"
            prefWidth="850.0"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="hr.algebra.theaterapp_gui.controller.TheaterController">

    <top>
        <VBox spacing="10.0">
            <padding>
                <Insets top="15.0"
                        right="15.0"
                        bottom="10.0"
                        left="15.0"/>
            </padding>

            <children>
                <Label text="Theaters"
                       style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

                <HBox spacing="8.0">
                    <children>
                        <TextField fx:id="searchField"
                                   promptText="Search theaters..."/>

                        <Button text="Search"
                                onAction="#search"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </top>

    <center>
        <TableView fx:id="theaterTableView">
            <columns>
                <TableColumn fx:id="nameColumn"
                             text="Name"
                             prefWidth="180.0"/>

                <TableColumn fx:id="cityColumn"
                             text="City"
                             prefWidth="130.0"/>

                <TableColumn fx:id="addressColumn"
                             text="Address"
                             prefWidth="250.0"/>

                <TableColumn fx:id="foundedYearColumn"
                             text="Founded"
                             prefWidth="100.0"/>

                <TableColumn fx:id="capacityColumn"
                             text="Capacity"
                             prefWidth="100.0"/>
            </columns>

            <BorderPane.margin>
                <Insets top="0.0"
                        right="15.0"
                        bottom="10.0"
                        left="15.0"/>
            </BorderPane.margin>
        </TableView>
    </center>

    <bottom>
        <HBox spacing="8.0">
            <padding>
                <Insets top="5.0"
                        right="15.0"
                        bottom="15.0"
                        left="15.0"/>
            </padding>

            <children>
                <Button fx:id="addButton"
                        text="Add"
                        onAction="#addTheater"/>

                <Button fx:id="editButton"
                        text="Edit"
                        onAction="#editTheater"/>

                <Button fx:id="deleteButton"
                        text="Delete"
                        onAction="#deleteTheater"/>

                <Button text="Details"
                        onAction="#showDetails"/>
            </children>
        </HBox>
    </bottom>

</BorderPane>