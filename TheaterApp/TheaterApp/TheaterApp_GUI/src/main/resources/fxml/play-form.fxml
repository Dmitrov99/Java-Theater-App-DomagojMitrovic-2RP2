<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER"
      prefHeight="510.0"
      prefWidth="600.0"
      spacing="20.0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="hr.algebra.theaterapp_gui.controller.PlayFormController">

    <padding>
        <Insets top="24.0"
                right="24.0"
                bottom="24.0"
                left="24.0"/>
    </padding>

    <Label fx:id="formTitleLabel"
           text="Add play"
           style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

    <GridPane hgap="12.0" vgap="12.0">
        <columnConstraints>
            <ColumnConstraints halignment="RIGHT" minWidth="145.0"/>
            <ColumnConstraints hgrow="ALWAYS" minWidth="300.0"/>
        </columnConstraints>

        <rowConstraints>
            <RowConstraints/>
            <RowConstraints/>
            <RowConstraints/>
            <RowConstraints/>
            <RowConstraints/>
            <RowConstraints/>
        </rowConstraints>

        <Label text="Play name:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="0"/>

        <TextField fx:id="nameField"
                   promptText="Enter play name"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="0"/>

        <Label text="Director:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="1"/>

        <ComboBox fx:id="directorComboBox"
                  promptText="Select director"
                  prefWidth="300.0"
                  GridPane.columnIndex="1"
                  GridPane.rowIndex="1"/>

        <Label text="Theater:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="2"/>

        <ComboBox fx:id="theaterComboBox"
                  promptText="Select theater"
                  prefWidth="300.0"
                  GridPane.columnIndex="1"
                  GridPane.rowIndex="2"/>

        <Label text="Premier date:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="3"/>

        <DatePicker fx:id="premierDatePicker"
                    promptText="Select premier date"
                    prefWidth="300.0"
                    GridPane.columnIndex="1"
                    GridPane.rowIndex="3"/>

        <Label text="Performances:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="4"/>

        <TextField fx:id="performanceCounterField"
                   promptText="Enter number of performances"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="4"/>

        <Label text="Play type:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="5"/>

        <ComboBox fx:id="playTypeComboBox"
                  promptText="Select play type"
                  prefWidth="300.0"
                  GridPane.columnIndex="1"
                  GridPane.rowIndex="5"/>
    </GridPane>

    <HBox alignment="CENTER_RIGHT" spacing="10.0">
        <Button mnemonicParsing="false"
                onAction="#save"
                text="Save"/>

        <Button mnemonicParsing="false"
                onAction="#cancel"
                text="Cancel"/>
    </HBox>
</VBox>