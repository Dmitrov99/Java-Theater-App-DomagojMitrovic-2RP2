<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="560.0"
            prefWidth="1000.0"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="hr.algebra.theaterapp_gui.controller.PlayController">

    <top>
        <VBox spacing="10.0">
            <padding>
                <Insets top="15.0"
                        right="20.0"
                        bottom="10.0"
                        left="20.0"/>
            </padding>

            <children>
                <Label text="Plays"
                       style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

                <HBox spacing="8.0">
                    <children>
                        <TextField fx:id="searchField"
                                   promptText="Search by play name"/>

                        <Button text="Search"
                                onAction="#search"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </top>

    <center>
        <TableView fx:id="playTableView">
            <BorderPane.margin>
                <Insets top="5.0"
                        right="20.0"
                        bottom="5.0"
                        left="20.0"/>
            </BorderPane.margin>

            <columns>
                <TableColumn fx:id="nameColumn"
                             prefWidth="190.0"
                             text="Name"/>

                <TableColumn fx:id="directorColumn"
                             prefWidth="180.0"
                             text="Director"/>

                <TableColumn fx:id="theaterColumn"
                             prefWidth="180.0"
                             text="Theater"/>

                <TableColumn fx:id="premierDateColumn"
                             prefWidth="130.0"
                             text="Premier date"/>

                <TableColumn fx:id="playTypeColumn"
                             prefWidth="130.0"
                             text="Play type"/>

                <TableColumn fx:id="performanceCounterColumn"
                             prefWidth="150.0"
                             text="Performances"/>
            </columns>
        </TableView>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT"
              spacing="10.0">
            <padding>
                <Insets top="10.0"
                        right="20.0"
                        bottom="15.0"
                        left="20.0"/>
            </padding>

            <children>
                <Button fx:id="addButton"
                        text="Add"
                        onAction="#addPlay"/>

                <Button fx:id="editButton"
                        text="Edit"
                        onAction="#editPlay"/>

                <Button fx:id="deleteButton"
                        text="Delete"
                        onAction="#deletePlay"/>

                <Button fx:id="castButton"
                        text="Cast"
                        onAction="#manageCast"/>
            </children>
        </HBox>
    </bottom>

</BorderPane>