<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane prefHeight="560.0"
            prefWidth="650.0"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="hr.algebra.theaterapp_gui.controller.TheaterFormController">

    <top>
        <Label fx:id="formTitleLabel"
               text="Add theater"
               style="-fx-font-size: 22px; -fx-font-weight: bold;">
            <BorderPane.margin>
                <Insets top="15.0"
                        right="20.0"
                        bottom="10.0"
                        left="20.0"/>
            </BorderPane.margin>
        </Label>
    </top>

    <center>
        <ScrollPane fitToWidth="true">
            <content>
                <GridPane hgap="12.0"
                          vgap="12.0">
                    <padding>
                        <Insets top="10.0"
                                right="20.0"
                                bottom="20.0"
                                left="20.0"/>
                    </padding>

                    <columnConstraints>
                        <ColumnConstraints minWidth="130.0"
                                           prefWidth="150.0"/>

                        <ColumnConstraints minWidth="300.0"
                                           prefWidth="420.0"
                                           hgrow="ALWAYS"/>
                    </columnConstraints>

                    <children>
                        <Label text="Name:"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="0"/>

                        <TextField fx:id="nameField"
                                   promptText="Enter theater name"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="0"/>

                        <Label text="Address:"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="1"/>

                        <TextField fx:id="addressField"
                                   promptText="Enter address"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="1"/>

                        <Label text="Founded year:"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="2"/>

                        <TextField fx:id="foundedYearField"
                                   promptText="Example: 1895"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="2"/>

                        <Label text="Auditorium capacity:"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="3"/>

                        <TextField fx:id="capacityField"
                                   promptText="Example: 800"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="3"/>

                        <Label text="Country:"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="4"/>

                        <ComboBox fx:id="countryComboBox"
                                  prefWidth="420.0"
                                  GridPane.columnIndex="1"
                                  GridPane.rowIndex="4"/>

                        <Label text="City:"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="5"/>

                        <ComboBox fx:id="cityComboBox"
                                  prefWidth="420.0"
                                  GridPane.columnIndex="1"
                                  GridPane.rowIndex="5"/>

                        <Label text="Image path:"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="6"/>

                        <TextField fx:id="imagePathField"
                                   promptText="/images/theater.jpg"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="6"/>

                        <Label text="History:"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="7"/>

                        <TextArea fx:id="historyTextArea"
                                  prefHeight="150.0"
                                  promptText="Enter a short theater history"
                                  wrapText="true"
                                  GridPane.columnIndex="1"
                                  GridPane.rowIndex="7"/>
                    </children>
                </GridPane>
            </content>
        </ScrollPane>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT"
              spacing="10.0">
            <padding>
                <Insets top="10.0"
                        right="20.0"
                        bottom="15.0"
                        left="20.0"/>
            </padding>

            <children>
                <Button text="Save"
                        onAction="#save"/>

                <Button text="Cancel"
                        onAction="#cancel"/>
            </children>
        </HBox>
    </bottom>

</BorderPane>